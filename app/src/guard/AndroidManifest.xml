<?xml version="1.0" encoding="utf-8"?>
<!-- No HOME category (see build.gradle.kts): here the home screen is an ordinary TV app that the
     home guard keeps in front. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.leslie.tvhome.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
